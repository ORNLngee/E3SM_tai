set(CXX_LINKER "CXX")
set(NETCDF_PATH "$ENV{NETCDF_PATH}")
set(NETCDF_C_PATH "$ENV{NETCDF_C_PATH}")
set(NETCDF_FORTRAN_PATH "$ENV{NETCDF_FORTRAN_PATH}")
set(HDF5_PATH "$ENV{HDF5_PATH}")
set(PNETCDF_PATH "")
set(BLASLAPACK_LIBDIR "$ENV{BLASLAPACK_LIBDIR}")
string(APPEND CFLAGS " -DNETCDF_ENABLE_LEGACY_MACROS")
string(APPEND FFLAGS " -fallow-argument-mismatch")
string(APPEND CFLAGS " -I${NETCDF_C_PATH}/include -I/usr/include")
string(APPEND FFLAGS " -I${NETCDF_FORTRAN_PATH}/include -I/usr/include")
string(APPEND SLIBS " -Wl,-rpath=${NETCDF_PATH}/lib -L${NETCDF_PATH}/lib -lnetcdf -lnetcdff")
string(APPEND SLIBS " -Wl,-rpath=${BLASLPACK_LIBDIR} -L${BLASLAPACK_LIBDIR} -lblas -llapack")
set(ALQUIMIA_PATH "$ENV{ALQUIMIA_PATH}/build/alquimia")
set(PFLOTRAN_PATH "$ENV{PFLOTRAN_PATH}")
string(APPEND FFLAGS " -I${ALQUIMIA_PATH} -I${PFLOTRAN_PATH}")
string(APPEND CFLAGS " -I${ALQUIMIA_PATH} -I${PFLOTRAN_PATH}")
string(APPEND SLIBS " -Wl,-rpath=${ALQUIMIA_PATH} -L${ALQUIMIA_PATH} -Wl,-rpath=${PFLOTRAN_PATH} -L${PFLOTRAN_PATH}")
